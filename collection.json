    {
      "name": "Listar e Filtrar",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "http://localhost:3001/veiculos?marca=Toyota", "protocol": "http", "host": ["localhost"], "port": "3001", "path": ["veiculos"], "query": [{ "key": "marca", "value": "Toyota" }] }
